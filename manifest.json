{
  "manifest_version": 3,
  "name": "Threads 자동 번역",
  "description": "스레드(Threads) 피드의 외국어 게시물에 있는 번역 버튼을 자동으로 눌러 줍니다.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "threads-auto-translate@philaxis",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.threads.com/*", "*://*.threads.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "스레드 자동 번역: 켜짐",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
