{
  "manifest_version": 3,
  "name": "스레드 자동 번역 (비공식)",
  "description": "스레드 외국어 글의 '번역하기' 버튼을 자동으로 눌러 줍니다. Meta와 관련 없는 비공식 확장입니다.",
  "version": "1.0.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "threads-auto-translate@philaxis",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/philaxis/threads-auto-translate/main/updates.json"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.threads.com/*",
        "*://*.threads.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "스레드 자동 번역: 켜짐",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
